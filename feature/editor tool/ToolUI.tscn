[sub_resource type="GDScript" id="GDScript_ie1n7"]
script/source = "@tool
extends Control

@onready var save_button: Button = $PanelContainer/VBoxContainer/SaveButton

func _ready() -> void:
	populate_texture_selection()

func populate_texture_selection():
	var path = \"res://feature/Cracks/\"
	var grid_con_path = $MarginContainer/VBoxContainer/PanelContainer/ScrollContainer/GridContainer
	print(\"populating texture grid\")
	var dir = DirAccess.open(path)
	if dir:
		dir.list_dir_begin()
		var file_name = dir.get_next()
		
		while file_name != \"\":
			if dir.current_is_dir():
				print(\"folder: \" + file_name)
				
			else:
				# filter by file ending
				var img:Image
				var tex:ImageTexture
				if file_name.ends_with(\"png\"):
					print(\"file: \" + file_name)
					img = Image.load_from_file(path + file_name)
					tex = ImageTexture.create_from_image(img)
				
				# perhaps do normal button plus background instead?
				
				var button = TextureButton.new()
				grid_con_path.add_child(button)
				button.texture_normal = tex
				
				# on button press setze variable (verknüpfe das signal I guess)
				button.pressed.connect(on_texture_button_clicked)
			file_name = dir.get_next()
	else:
		print(\"Textures Filepath could not be accessed\")
	
func on_texture_button_clicked():
	# how do I know which button it is being pressed?
	print(\"click\")

#export the config
func _on_save_button_pressed() -> void:
	print(\"creating config resource\")
	var config_file:EnemyConfig = EnemyConfig.new()
	config_file.author = \"new name\"
	ResourceSaver.save(config_file,\"res://config.tres\")
"

